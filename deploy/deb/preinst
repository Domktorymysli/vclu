#!/bin/sh
set -e

# Before an upgrade (or a first package install over an install.sh setup): back up the
# configuration, as update.sh does. History, metrics and vCLU's own backups are left out.

case "$1" in
  install|upgrade) ;;
  *) exit 0 ;;
esac

[ -x /opt/vclu/vclu ] || exit 0

DATA_DIR=/opt/vclu/data
UNIT=/etc/systemd/system/vclu.service
if [ -f "$UNIT" ]; then
  d=$(sed -n 's/^WorkingDirectory=//p' "$UNIT" | head -1)
  [ -n "$d" ] && DATA_DIR=$d
fi
[ -d "$DATA_DIR" ] || exit 0

CURRENT=$(/opt/vclu/vclu -version 2>/dev/null | sed -n 's/.*version \([^ ]*\).*/\1/p')
BACKUP="/opt/vclu/backup-${CURRENT:-unknown}-$(date +%Y%m%d-%H%M%S).tar.gz"
NAME=$(basename "$DATA_DIR")

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl stop vclu 2>/dev/null || true
fi
if ! (umask 077 && tar -czf "$BACKUP" \
      --exclude="$NAME/clu/history" --exclude="$NAME/clu/metrics" --exclude="$NAME/clu/backups*" \
      --exclude="$NAME/clu/workspace/backups" --exclude="$NAME/backup" --exclude="$NAME/backup-*" \
      -C "$(dirname "$DATA_DIR")" "$NAME"); then
  rm -f "$BACKUP"
  echo "vclu: backup of $DATA_DIR failed (disk full?); nothing was changed" >&2
  exit 1
fi
echo "vclu: configuration backed up to $BACKUP"

# Keep the three newest (names are ours: no odd characters)
# shellcheck disable=SC2012
ls -1t /opt/vclu/backup-*.tar.gz 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old"; done
exit 0
